{
 "name": "Client Submission",
 "doctype": "DocType",
 "module": "Client Portal",
 "track_changes": 1,
 "autoname": "SUB-.YYYY.-.#####",
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Client Company",
   "options": "Client Company",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "submission_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Expense Claim\nSales Invoice\nBookkeeping Batch\nPayroll Input\nDocument",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Submitted\nReceived\nIn Review\nNeeds Info\nProcessed\nRejected",
   "default": "Submitted",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "period",
   "fieldtype": "Data",
   "label": "Period",
   "in_list_view": 1
  },
  {
   "fieldname": "cb_info",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "submitted_by",
   "fieldtype": "Link",
   "label": "Submitted By",
   "options": "User",
   "in_list_view": 1
  },
  {
   "fieldname": "handled_by",
   "fieldtype": "Link",
   "label": "Handled By (Staff)",
   "options": "User"
  },
  {
   "fieldname": "sb_totals",
   "fieldtype": "Section Break",
   "label": "Financial Totals"
  },
  {
   "fieldname": "total_net",
   "fieldtype": "Currency",
   "label": "Total Net (\u00a3)",
   "read_only": 1
  },
  {
   "fieldname": "total_vat",
   "fieldtype": "Currency",
   "label": "Total VAT (\u00a3)",
   "read_only": 1
  },
  {
   "fieldname": "total_gross",
   "fieldtype": "Currency",
   "label": "Total Gross (\u00a3)",
   "read_only": 1
  },
  {
   "fieldname": "sb_notes",
   "fieldtype": "Section Break",
   "label": "Notes & Rejection Reason"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Client Notes"
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Small Text",
   "label": "Rejection / Info Reason"
  },
  {
   "fieldname": "sb_items",
   "fieldtype": "Section Break",
   "label": "Submission Items"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Line Items",
   "options": "Client Submission Item"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Client Portal Staff",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Client Portal User",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}