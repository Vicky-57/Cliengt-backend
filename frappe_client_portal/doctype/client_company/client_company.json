{
 "name": "Client Company",
 "doctype": "DocType",
 "module": "Client Portal",
 "custom": 0,
 "track_changes": 1,
 "naming_rule": "By fieldname",
 "autoname": "field:company_name",
 "fields": [
  {
   "fieldname": "company_name",
   "fieldtype": "Data",
   "label": "Company Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "label": "Primary Email",
   "options": "Email"
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "Phone Number"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nOnboarding\nSuspended",
   "default": "Active",
   "in_list_view": 1
  },
  {
   "fieldname": "sb_tax",
   "fieldtype": "Section Break",
   "label": "Tax & Registration Details"
  },
  {
   "fieldname": "company_number",
   "fieldtype": "Data",
   "label": "Company Number (Companies House)"
  },
  {
   "fieldname": "vat_number",
   "fieldtype": "Data",
   "label": "VAT Registration Number"
  },
  {
   "fieldname": "sb_address",
   "fieldtype": "Section Break",
   "label": "Addresses"
  },
  {
   "fieldname": "registered_address",
   "fieldtype": "Small Text",
   "label": "Registered Address"
  },
  {
   "fieldname": "cb_address",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "trading_address",
   "fieldtype": "Small Text",
   "label": "Trading Address"
  },
  {
   "fieldname": "sb_bank",
   "fieldtype": "Section Break",
   "label": "Bank Details"
  },
  {
   "fieldname": "bank_name",
   "fieldtype": "Data",
   "label": "Bank Name"
  },
  {
   "fieldname": "account_number",
   "fieldtype": "Data",
   "label": "Account Number"
  },
  {
   "fieldname": "sort_code",
   "fieldtype": "Data",
   "label": "Sort Code"
  },
  {
   "fieldname": "sb_staff",
   "fieldtype": "Section Break",
   "label": "Staff Assignment"
  },
  {
   "fieldname": "assigned_accountant",
   "fieldtype": "Link",
   "label": "Assigned Accountant",
   "options": "User",
   "in_list_view": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Client Portal Staff",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Client Portal User",
   "read": 1,
   "write": 1
  }
 ]
}